// src/models/AuditLog.js

const mongoose = require("mongoose");


const auditSchema = new mongoose.Schema(
{

user:{
    type:mongoose.Schema.Types.ObjectId,
    ref:"User"
},


action:{
    type:String,
    required:true
},


resource:{
    type:String,
    required:true
},


resourceId:{
    type:String
},


ip:{
    type:String
},


userAgent:{
    type:String
},


oldData:{
    type:Object
},


newData:{
    type:Object
},


status:{
    type:String,
    enum:[
        "SUCCESS",
        "FAILED"
    ],
    default:"SUCCESS"
}


},
{
timestamps:true
});


module.exports =
mongoose.model(
"AuditLog",
auditSchema
);
