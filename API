app.get(
    "/api/nearby",
    async (req, res) => {

        const lat =
            Number(req.query.lat);

        const lng =
            Number(req.query.lng);

        const radius =
            Math.min(
                Math.max(
                    Number(
                        req.query.radius ||
                        25
                    ),
                    1
                ),
                100
            );

        const type =
            String(
                req.query.type ||
                "all"
            );


        if (
            !Number.isFinite(lat) ||
            !Number.isFinite(lng) ||
            lat < -90 ||
            lat > 90 ||
            lng < -180 ||
            lng > 180
        ) {

            return res.status(400).json({
                message:
                    "Invalid GPS coordinates."
            });
        }


        try {

            const results = [];


            if (
                type === "all" ||
                type === "businesses"
            ) {

                const result =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            address,
                            latitude,
                            longitude,
                            logo,
                            cover_image,
                            rating,
                            ROUND(
                                (
                                    ST_Distance(
                                        location_point,
                                        ST_SetSRID(
                                            ST_MakePoint(
                                                $1,
                                                $2
                                            ),
                                            4326
                                        )::geography
                                    ) / 1000
                                )::numeric,
                                2
                            ) AS distance,
                            'business' AS type
                        FROM businesses
                        WHERE location_point IS NOT NULL
                        AND ST_DWithin(
                            location_point,
                            ST_SetSRID(
                                ST_MakePoint(
                                    $1,
                                    $2
                                ),
                                4326
                            )::geography,
                            $3 * 1000
                        )
                        ORDER BY distance
                        LIMIT 100
                        `,
                        [
                            lng,
                            lat,
                            radius
                        ]
                    );


                results.push(
                    ...result.rows
                );
            }


            if (
                type === "all" ||
                type === "tourism"
            ) {

                const result =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            location,
                            latitude,
                            longitude,
                            image,
                            rating,
                            ROUND(
                                (
                                    ST_Distance(
                                        location_point,
                                        ST_SetSRID(
                                            ST_MakePoint(
                                                $1,
                                                $2
                                            ),
                                            4326
                                        )::geography
                                    ) / 1000
                                )::numeric,
                                2
                            ) AS distance,
                            'tourism' AS type
                        FROM tourism
                        WHERE location_point IS NOT NULL
                        AND ST_DWithin(
                            location_point,
                            ST_SetSRID(
                                ST_MakePoint(
                                    $1,
                                    $2
                                ),
                                4326
                            )::geography,
                            $3 * 1000
                        )
                        ORDER BY distance
                        LIMIT 100
                        `,
                        [
                            lng,
                            lat,
                            radius
                        ]
                    );


                results.push(
                    ...result.rows
                );
            }


            if (
                type === "all" ||
                type === "products"
            ) {

                const result =
                    await pool.query(
                        `
                        SELECT
                            id,
                            name,
                            description,
                            category,
                            price,
                            currency,
                            image,
                            latitude,
                            longitude,
                            ROUND(
                                (
                                    ST_Distance(
                                        location_point,
                                        ST_SetSRID(
                                            ST_MakePoint(
                                                $1,
                                                $2
                                            ),
                                            4326
                                        )::geography
                                    ) / 1000
                                )::numeric,
                                2
                            ) AS distance,
                            'product' AS type
                        FROM products
                        WHERE location_point IS NOT NULL
                        AND ST_DWithin(
                            location_point,
                            ST_SetSRID(
                                ST_MakePoint(
                                    $1,
                                    $2
                                ),
                                4326
                            )::geography,
                            $3 * 1000
                        )
                        ORDER BY distance
                        LIMIT 100
                        `,
                        [
                            lng,
                            lat,
                            radius
                        ]
                    );


                results.push(
                    ...result.rows
                );
            }


            results.sort(
                (a, b) =>
                    Number(a.distance || 0) -
                    Number(b.distance || 0)
            );


            res.json(results);

        } catch (error) {

            console.error(
                "Nearby search:",
                error
            );


            res.status(500).json({
                message:
                    "Nearby search failed."
            });
        }
    }
);
