import { Module } from '@nestjs/common';
import { BullModule } from '@nestjs/bullmq';
import { SearchQueueService } from './search-queue.service';

@Module({
  imports: [
    BullModule.registerQueue({
      name: 'search-index',
    }),
  ],
  providers: [SearchQueueService],
  exports: [SearchQueueService],
})
export class SearchQueueModule {}

> cat queue.service
import { Injectable } from '@nestjs/common';
import { InjectQueue } from '@nestjs/bullmq';
import { Queue } from 'bullmq';

import { SEARCH_QUEUE } from './jobs/search.queue';
import { SearchJobs } from './jobs/search.jobs';

@Injectable()
export class SearchQueueService {

    constructor(
        @InjectQueue(SEARCH_QUEUE)
        private readonly queue: Queue,
    ) {}

    async indexUser(id: string) {

        await this.queue.add(
            SearchJobs.INDEX_USER,

            { id },

            {
                attempts: 5,

                backoff: {
                    type: 'exponential',
                    delay: 1000,
                },

                removeOnComplete: 1000,

                removeOnFail: 500,
            },
        );

    }

    async updateUser(id: string) {

        await this.queue.add(
            SearchJobs.UPDATE_USER,
            { id },
        );

    }

    async deleteUser(id: string) {

        await this.queue.add(
            SearchJobs.DELETE_USER,
            { id },
        );

    }

}
