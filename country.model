"""
ASEM Global Platform
Country Model
"""

from app.extensions import db
from datetime import datetime


class Country(db.Model):
    """
    Represents a country in the ASEM Global Platform.
    """

    __tablename__ = "countries"

    # ===========================
    # Primary Key
    # ===========================
    id = db.Column(
        db.Integer,
        primary_key=True
    )

    # ===========================
    # Basic Information
    # ===========================
    name = db.Column(
        db.String(100),
        nullable=False,
        unique=True,
        index=True
    )

    code = db.Column(
        db.String(3),  # ISO Alpha-3
        nullable=False,
        unique=True,
        index=True
    )

    phone_code = db.Column(
        db.String(20),
        nullable=True
    )

    currency = db.Column(
        db.String(50),
        nullable=True
    )

    language = db.Column(
        db.String(100),
        nullable=True
    )

    description = db.Column(
        db.Text,
        nullable=True
    )

    flag = db.Column(
        db.String(255),
        nullable=True
    )

    # ===========================
    # Status
    # ===========================
    is_active = db.Column(
        db.Boolean,
        default=True,
        nullable=False
    )

    # ===========================
    # Timestamps
    # ===========================
    created_at = db.Column(
        db.DateTime,
        default=datetime.utcnow,
        nullable=False
    )

    updated_at = db.Column(
        db.DateTime,
        default=datetime.utcnow,
        onupdate=datetime.utcnow,
        nullable=False
    )

    # ===========================
    # Relationships
    # ===========================
    cities = db.relationship(
        "City",
        back_populates="country",
        cascade="all, delete-orphan",
        lazy="dynamic"
    )

    # ===========================
    # Magic Methods
    # ===========================
    def __repr__(self):
        return f"<Country {self.name}>"

    def __str__(self):
        return self.name

    # ===========================
    # Utility Methods
    # ===========================
    def activate(self):
        self.is_active = True

    def deactivate(self):
        self.is_active = False

    def to_dict(self, include_cities=False):
        """
        Convert the country object to a dictionary.
        Optionally include related cities.
        """

        data = {
            "id": self.id,
            "name": self.name,
            "code": self.code,
            "phone_code": self.phone_code,
            "currency": self.currency,
            "language": self.language,
            "description": self.description,
            "flag": self.flag,
            "is_active": self.is_active,
            "created_at": self.created_at.isoformat() if self.created_at else None,
            "updated_at": self.updated_at.isoformat() if self.updated_at else None
        }

        if include_cities:
            data["cities"] = [city.to_dict() for city in self.cities.all()]

        return data
